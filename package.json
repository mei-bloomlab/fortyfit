{
  "name": "fortyfit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 43147",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 43147",
    "lint": "eslint",
    "db:prepare": "prisma generate && prisma db push && prisma db seed",
    "db:seed": "prisma db seed",
    "openwa": "node scripts/openwa-run.mjs",
    "openwa:bridge": "node scripts/openwa-bridge.mjs",
    "openwa:drain": "tsx scripts/openwa-drain.ts",
    "test": "tsx --test src/lib/time.test.ts src/lib/openwa/messages.test.ts src/lib/openwa/digest.test.ts src/lib/openwa/sidecar-browser.test.ts scripts/openwa-http.test.mjs scripts/openwa-launch.test.mjs",
    "test:openwa": "tsx scripts/verify-openwa-flow.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@prisma/client": "6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
